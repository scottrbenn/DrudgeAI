# Copy this file to .env.local and fill in your values

# Your beehiiv newsletter embed URL
# Get this from: beehiiv dashboard → your publication → Embed → Copy URL
NEXT_PUBLIC_BEEHIIV_URL=https://embeds.beehiiv.com/YOUR-PUBLICATION-ID

# Google Analytics 4 Measurement ID
# Get this from: analytics.google.com → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
