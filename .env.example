# Copy this file to .env.local and fill in your values

# Your beehiiv newsletter embed URL
# Get this from: beehiiv dashboard → your publication → Embed → Copy URL
NEXT_PUBLIC_BEEHIIV_URL=https://embeds.beehiiv.com/YOUR-PUBLICATION-ID

# Google Analytics 4 Measurement ID
# Get this from: analytics.google.com → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Twitter / X API Bearer Token (optional — enables "Trending on X" section)
# Cost: ~$18/month at pay-per-use pricing ($0.005/tweet, 20 tweets every 4 hours)
# Get this from: developer.x.com → Create Project → Keys & Tokens → Bearer Token
TWITTER_BEARER_TOKEN=your_bearer_token_here
